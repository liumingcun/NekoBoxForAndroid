<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <color name="nb_background">#E8EDF5</color>
    <color name="nb_surface">#FFFFFF</color>
    <color name="nb_text">#1D2B3A</color>
    <color name="nb_secondary">#52647A</color>
    <color name="nb_accent">#007AFF</color>
    <color name="nb_connected">#248A3D</color>
    <color name="nb_separator">#D4DEEC</color>
    <style name="Theme.SagerNet.Cupertino" parent="Theme.SagerNet">
        <item name="colorPrimary">@color/nb_accent</item>
        <item name="colorPrimaryDark">@color/nb_background</item>
        <item name="colorAccent">@color/nb_accent</item>
        <item name="colorSurface">@color/nb_surface</item>
        <item name="colorOnSurface">@color/nb_text</item>
        <item name="android:colorBackground">@color/nb_background</item>
        <item name="android:windowBackground">@color/nb_background</item>
        <item name="android:statusBarColor">@color/nb_background</item>
        <item name="android:navigationBarColor">@color/nb_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.DayNight</item>
        <item name="tabTextColor">@color/nb_secondary</item>
        <item name="tabSelectedTextColor">@color/nb_accent</item>
        <item name="tabIndicatorColor">@color/nb_accent</item>
        <item name="whiteOrTextPrimary">@color/nb_text</item>
    </style>
    <style name="Theme.SagerNet.Dialog.Cupertino" parent="Theme.SagerNet.Dialog">
        <item name="colorPrimary">@color/nb_accent</item>
        <item name="colorAccent">@color/nb_accent</item>
        <item name="colorSurface">@color/nb_surface</item>
        <item name="colorOnSurface">@color/nb_text</item>
    </style>
    <string tools:ignore="MissingTranslation" name="nb_home">Home</string>
    <string tools:ignore="MissingTranslation" name="nb_test_hint">Tap to test connection</string>
    <string tools:ignore="MissingTranslation" name="nb_upload">Upload</string>
    <string tools:ignore="MissingTranslation" name="nb_download">Download</string>
    <color name="nb_card_border">#CBD7E6</color>
    <color name="nb_connection_surface">#DCEAFE</color>
    <color name="nb_selected_surface">#EAF3FF</color>
</resources>
